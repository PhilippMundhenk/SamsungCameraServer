<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- SAF provider for the instrumented tests; same UID as the app, so no grants are needed. -->
        <provider
            android:name="org.mundhenk.cambackup.app.TestDocumentsProvider"
            android:authorities="org.mundhenk.cambackup.test.documents"
            android:exported="false"
            android:grantUriPermissions="true">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
